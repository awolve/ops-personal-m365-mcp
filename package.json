{
  "name": "@awolve/myoffice",
  "version": "2.13.1",
  "description": "CLI for personal Microsoft 365 access - email, calendar, tasks, OneDrive, Teams, Planner",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "myoffice": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "@awolve:registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/signature.test.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "echo '\n✅ @awolve/myoffice installed!\n\nRun: myoffice --help\nOr:  npx @awolve/myoffice --help\n'",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "login": "tsx src/cli.ts login"
  },
  "dependencies": {
    "@azure/identity": "^4.2.0",
    "@azure/msal-node": "^2.9.0",
    "commander": "^12.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "author": "Awolve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awolve/ops-myoffice.git"
  },
  "keywords": [
    "cli",
    "microsoft365",
    "outlook",
    "calendar",
    "office365",
    "email"
  ]
}
